# Copy this file to .env and fill in your real key. .env is gitignored -
# never commit a real API key.
#
# If you already set ANTHROPIC_API_KEY as a system/user environment variable
# (e.g. via `setx ANTHROPIC_API_KEY "..."` for the .NET backend), you can
# skip this file entirely - python-dotenv only fills in variables that
# aren't already set in the environment, so the same key is reused.

ANTHROPIC_API_KEY=your_api_key_here
